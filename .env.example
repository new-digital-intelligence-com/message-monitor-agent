# Copy to .env. Only the env vars actually referenced by your config/accounts.yaml
# are required — this lists every var used by the example config.

CONFIG_PATH=config/accounts.yaml
DATA_DIR=data
PORT=3000
NODE_ENV=development

# --- Unipile (LinkedIn) -------------------------------------------------
UNIPILE_BASE_URL=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=

# --- Slack ---------------------------------------------------------------
SLACK_BOT_TOKEN=

# --- SMTP (outgoing "email" notify targets) -------------------------------
SMTP_USER=
SMTP_PASSWORD=

# --- Gmail OAuth2 (per Gmail account; refresh token is per-mailbox) ------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SALES_GMAIL_REFRESH_TOKEN=

# --- Generic IMAP mailbox --------------------------------------------------
SUPPORT_IMAP_USER=
SUPPORT_IMAP_PASSWORD=
